{
  "description": "The lifecycle update script moves an item through implementation and review, then closes it with a synchronized Outcome and INDEX status.",
  "steps": [
    {"type": "run", "args": ["close-task", "--scope", "api"]},
    {"type": "run", "script": "update", "args": ["update", "close-task", "--status", "in-progress"]},
    {"type": "run", "script": "update", "args": ["update", "close-task", "--status", "review"]},
    {"type": "run", "script": "update", "args": ["close", "close-task", "--outcome", "Shipped successfully.", "--pr", "PR #42"]},
    {"type": "run", "script": "update", "args": ["check"]}
  ],
  "checks": {
    "content_contains": [
      {"glob": "progress/*-close-task/PROGRESS.md", "text": "**Status:** done"},
      {"glob": "progress/*-close-task/PROGRESS.md", "text": "**Final status:** done"},
      {"glob": "progress/*-close-task/PROGRESS.md", "text": "**PR / Commit:** PR #42"},
      {"glob": "progress/INDEX.md", "text": "| `done` | Close Task |"}
    ],
    "content_not_contains": [
      {"glob": "progress/INDEX.md", "text": "| `planning` | Close Task |"}
    ]
  }
}
